# Core
BTC_MARKET=KRW-BTC
BTC_HISTORY_YEARS=8
ANALYSIS_CACHE_TTL_SECONDS=300
MAX_CRITIC_ITERATIONS=2

# Optional LLM agents. Keep the key only on the backend host.
USE_LLM=false
OPENAI_MODEL=gpt-5.6-terra
USE_SPECIALIST_LLM=true
# OPENAI_API_KEY=your-key-here

# Optional macro provider. Without this, the macro tool attempts a public fallback.
# FRED_API_KEY=your-fred-key

# Frontend origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://leejaehoon1234.github.io
